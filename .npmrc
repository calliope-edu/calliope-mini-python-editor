# Authenticate against GitHub Packages for the @calliope-edu scope.
# Required for the private @calliope-edu/calliope-theme package used by the
# CI build step (see .github/workflows/build.yml).
#
# Set NODE_AUTH_TOKEN in the build environment to a PAT with `read:packages`.
# - Cloudflare Pages: Project -> Settings -> Environment variables.
# - Local dev: export NODE_AUTH_TOKEN, or place a token in ~/.npmrc instead.
@calliope-edu:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
